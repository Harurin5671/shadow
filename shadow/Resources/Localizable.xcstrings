    "onboarding.step1.headline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No server reads\\nyour messages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún servidor\\nlee tus\\nmensajes."
          }
        }
      }
    },
    "onboarding.step1.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your encryption key never leaves your\\ndevice. AES-256-GCM. Only those\\npresent can read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave de cifrado nunca sale de\\ntu dispositivo. AES-256-GCM. Solo\\nlos presentes pueden leer."
          }
        }
      }
    },
    "onboarding.step2.badge" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Self-Destruction"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-destrucción"
