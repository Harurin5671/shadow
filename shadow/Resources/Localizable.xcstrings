    "onboarding.step3.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No screenshots. No exports. No logs. If\\nsomeone tries, everyone gets an\\ninstant alert"
